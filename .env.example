DATABASE_DB="your_database_name"
DATABASE_USER="postgres"
DATABASE_PASSWORD="custom_db_password"

POSTGRES_PRISMA_URL="postgresql://postgres:custom_db_password@localhost:5432/your_database_name"
AUTHENTICATION_SECRET_KEY="random_hash_1234567890ABCDE"

STRIPE_PUBLIC_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
POLAR_ACCESS_TOKEN="polar_oat_..."
POLAR_WEBHOOK_SECRET="whsec_..."
POLAR_ENVIRONMENT="sandbox"
BILLING_PROVIDER="polar"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# IA (conciliação de PDF, chat): provedor trocável sem mudar código.
# AI_PROVIDER="openai" (padrão gpt-4o-mini, pago) | "google" (padrão gemini-2.5-flash-lite)
#   | "openrouter" (padrão openrouter/free, gratuito; 50 req/dia sem cartão).
# Sem chave configurada, recursos de IA desabilitam com mensagem; CSV/OFX funcionam.
# No OpenRouter, desligue o treino com seus dados e ative ZDR em Privacy settings.
AI_PROVIDER="openai"
AI_MODEL="gpt-4o-mini"
OPENAI_API_KEY="sk-..."
GOOGLE_GENERATIVE_AI_API_KEY="..."
OPENROUTER_API_KEY="..."
