enum DebtStatus {
    ACTIVE
    PAID
    CANCELED
}

model Debt {
    id               String     @id @default(cuid())
    userId           String
    user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    categoryId       String
    category         Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
    creditor         String
    description      String
    totalAmount      Int        // In cents, total outstanding when the debt was registered
    installmentCount Int
    status           DebtStatus @default(ACTIVE)
    installments     DebtInstallment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userId])
    @@index([categoryId])
    @@index([status])
}

model DebtInstallment {
    id            String        @id @default(cuid())
    debtId        String
    debt          Debt          @relation(fields: [debtId], references: [id], onDelete: Cascade)
    number        Int
    plannedAmount Int           // In cents, remaining amount planned for this due date
    dueDate       DateTime
    payments      DebtPayment[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([debtId, number])
    @@index([debtId, dueDate])
}

model DebtPayment {
    id            String          @id @default(cuid())
    installmentId String
    installment   DebtInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
    eventId       String          @unique
    event         Event           @relation(fields: [eventId], references: [id], onDelete: Restrict)
    amount        Int             // In cents, always positive

    createdAt DateTime @default(now())

    @@index([installmentId])
}
