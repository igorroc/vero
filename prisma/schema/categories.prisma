// ============================================
// CATEGORIES
// ============================================

enum CategoryGroupType {
    INCOME
    ESSENTIAL
    LIFESTYLE
    INVESTMENT
}

model CategoryGroup {
    id         String            @id
    name       String            @unique
    type       CategoryGroupType
    categories Category[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Category {
    id              String        @id @default(cuid())
    userId          String
    user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    categoryGroupId String
    categoryGroup   CategoryGroup @relation(fields: [categoryGroupId], references: [id], onDelete: Restrict)
    name            String
    events          Event[]
    budgetItems     BudgetItem[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([userId, categoryGroupId, name])
    @@index([userId])
    @@index([categoryGroupId])
}
